# Movie Provider Configuration
# auto = prefer IMDb236, then MoviesDatabase, then OMDb
# imdb236 = force IMDb236 first
# moviesdb = force MoviesDatabase first
# omdb = force OMDb first
VITE_MOVIE_PROVIDER=auto

# IMDb236 (RapidAPI)
# Get your key at: https://rapidapi.com/octopusteam-octopusteam-default/api/imdb236
VITE_IMDB236_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_IMDB236_RAPIDAPI_HOST=imdb236.p.rapidapi.com

# MoviesDatabase (RapidAPI)
# Get your key at: https://rapidapi.com/SAdrian/api/moviesdatabase
VITE_MOVIESDB_RAPIDAPI_KEY=your_rapidapi_key_here
VITE_MOVIESDB_RAPIDAPI_HOST=moviesdatabase.p.rapidapi.com

# OMDb fallback key
# Get your free API key at: https://www.omdbapi.com/apikey.aspx
VITE_OMDB_API_KEY=your_omdb_api_key_here
